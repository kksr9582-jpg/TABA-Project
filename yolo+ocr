  def filter_strings(string_list):
      filtered_list = []
      include_strings = ['.', '/', '~', '월', '일', '년','-', '까지',',']
      exclude_strings = ['상금','원','파일','규격','양식','메일','주소','+']

      for string in string_list:
          if any(include_string in string for include_string in include_strings) and not any(exclude_string in string for exclude_string in exclude_strings) and any(char.isdigit() for char in string):
              filtered_list.append(string)

      return filtered_list

  def extract_dates_from_strings(string_list, patterns, exclude_patterns):
      dates = []
      extracted_strings = set()

      for string in string_list:
          for pattern in patterns:
              match = pattern.search(string)
              if match:
                  extracted_string = match.group()

                  # 여기서 제외 패턴 체크
                  if any(exclude_pattern.search(extracted_string) for exclude_pattern in exclude_patterns):
                      continue

                  if extracted_string not in extracted_strings:
                      dates.append(extracted_string)
                      extracted_strings.add(extracted_string)
                  break

      return dates


  def split_list_elements(string_list, split_chars='~-'):
      split_list = []

      for item in string_list:
          # split_chars 중 하나라도 있는지 확인
          if any(char in item for char in split_chars):
              # split_chars를 기준으로 분리하고 분리된 문자열들을 새 리스트에 추가
              for char in split_chars:
                  item = item.replace(char, split_chars[0])  # 일관된 구분자로 변경
              split_list.extend([i.strip() for i in item.split(split_chars[0])])
          else:
              split_list.append(item)

      return split_list

