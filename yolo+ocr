    </div>
</body>
</html>
"""

# 캘린더 생성 함수
def generate_calendar(year, month, events):
    cal = calendar.HTMLCalendar()
    month_calendar = cal.formatmonth(year, month)

    # 오늘 날짜 표시
    today = date.today()

    # 일정 표시 추가
    for event_date, event_description in events.items():
        if event_date.year == year and event_date.month == month:
            day_cell = f">{event_date.day}<"
            event_cell = f' class="event">{event_date.day}<br>{event_description}<'
            month_calendar = month_calendar.replace(day_cell, event_cell)

    # 오늘 날짜 강조
    if today.year == year and today.month == month:
        day_cell = f">{today.day}<"
        today_cell = f' class="today">{today.day}<'
        month_calendar = month_calendar.replace(day_cell, today_cell)

    return month_calendar

# 기본 캘린더 페이지
@app.route('/calendar/<int:year>/<int:month>')
def calendar_view(year, month):
    # 이전/다음 달 계산
    prev_month = month - 1 if month > 1 else 12
    next_month = month + 1 if month < 12 else 1
    prev_year = year if month > 1 else year - 1
    next_year = year if month < 12 else year + 1

    # 캘린더 생성
    cal = generate_calendar(year, month, events)

    return render_template_string(
        HTML_TEMPLATE,
        year=year,
        month=month,
        prev_month=prev_month,
        next_month=next_month,
        calendar=cal
    )

# 이벤트 추가 라우트
@app.route('/add_event', methods=['POST'])
def add_event():
    global events
    try:
        # 폼 데이터에서 날짜와 이벤트 설명 가져오기
        event_date_str = request.form['date']
        event_description = request.form['event']
        event_date = date.fromisoformat(event_date_str)  # ISO 포맷을 datetime.date로 변환

        # 이벤트 저장
        events[event_date] = event_description

        # 성공적으로 추가한 후 해당 달로 리디렉션
        return calendar_view(event_date.year, event_date.month)
    except Exception as e:
        # 날짜가 유효하지 않을 경우 에러 표시
        return render_template_string(
            HTML_TEMPLATE,
            year=date.today().year,
            month=date.today().month,
            prev_month=date.today().month - 1,
            next_month=date.today().month + 1,
            calendar=generate_calendar(date.today().year, date.today().month, events),
            error="Invalid date or event. Please try again."
        )

# 기본 페이지
@app.route('/')
def index():
    today = date.today()
    return calendar_view(today.year, today.month)

# Flask 실행
if __name__ == '__main__':
    app.run()

